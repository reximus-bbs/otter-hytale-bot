# --- required ---
# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=changeme

# Channel where the pinned live status embed lives.
# Right-click channel -> Copy ID (Developer Mode must be on).
STATUS_CHANNEL_ID=000000000000000000

# Hytale Nitrado Query endpoint
QUERY_URL=https://otter-nonsense-hytale.nodecraft.gg:5523/Nitrado/Query

# --- recommended ---
# Speeds up slash command registration by scoping to one guild.
GUILD_ID=000000000000000000

# Service account credentials. Username MUST start with `serviceaccount.`
QUERY_USER=serviceaccount.discord
QUERY_PASS=changeme

# --- features (omit any to disable that feature) ---
# Channel where 🟢 joined / 🔴 left embeds get posted.
ACTIVITY_CHANNEL_ID=000000000000000000

# Voice channel that gets renamed to "🟢 4/20 playing" — bot needs Manage Channel here.
COUNTER_VOICE_CHANNEL_ID=000000000000000000

# Channel where the daily 9am recap lands.
RECAP_CHANNEL_ID=000000000000000000

# --- tuning ---
POLL_SECONDS=60
INSECURE_TLS=true
RECAP_TIMEZONE=America/Chicago
RECAP_HOUR=9
COUNTER_TEMPLATE=🟢 {current}/{max} playing
COUNTER_OFFLINE_TEMPLATE=🔴 server offline
COUNTER_MIN_INTERVAL_S=300

# --- branding (all optional) ---
# Tagline shown in the status embed description.
SERVER_TAGLINE=A chill community Hytale server. Everyone welcome — bring a friend.
# Top-right square thumbnail (server logo / otter avatar). Public HTTPS URL.
# THUMBNAIL_URL=https://i.imgur.com/your-otter.png
# Wide image at the bottom of the embed (banner). Public HTTPS URL.
# BANNER_URL=https://i.imgur.com/your-banner.png

# --- persistence ---
DB_PATH=otter.db
STATE_FILE=state.json
